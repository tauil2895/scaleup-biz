# ==============================================================================
# ScaleUp Biz - Global Environment Variables Template
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=your-super-secret-dev-key-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=scaleup_biz_db
DB_USER=postgres_user
DB_PASSWORD=postgres_secure_password
DB_HOST=postgres
DB_PORT=5432

# Caching & Async Task Queue (Redis & Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Stable and lightweight Python runtime
FROM python:3.11.9-slim-bookworm as base

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Working directory within the container space
WORKDIR /app

# Install native system dependencies required to compile Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Setup a secure non-root system group and user
RUN groupadd -g 1000 django && useradd -u 1000 -g django -m -s /bin/bash django

# Ensure pip is up to date
RUN pip install --no-cache-dir --upgrade pip